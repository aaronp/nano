{
  "pods": {
    "todoStore": {
      "implementation": "example.kv/memory",
      "eager": false
    },
    "todos": {
      "implementation": "example.todo/kv",
      "eager": false
    }
  },
  "runtimes": {
    "example.todo.frontend": {
      "pods": [
        "todos"
      ],
      "subscriptions": []
    },
    "example.todo.backend": {
      "pods": [
        "todoStore"
      ],
      "subscriptions": [
        {
          "kind": "call",
          "from": "todos",
          "to": "todoStore"
        }
      ],
      "policy": {
        "kind": "rules",
        "rules": [
          {
            "allow": [
              "call",
              "subscribe"
            ],
            "from": "todos",
            "outside": true,
            "toInterface": "example.kv.KeyValueStore"
          },
          {
            "allow": "subscribe",
            "from": "host",
            "outside": true,
            "toInterface": "example.kv.KeyValueStore"
          },
          {
            "allow": "*",
            "outside": false
          },
          {
            "allow": "start",
            "from": "host",
            "outside": true
          },
          {
            "deny": "*"
          }
        ]
      }
    }
  },
  "modules": {
    "example.kv": "../kv/memory.js",
    "example.todo": "./todo/kv.js"
  },
  "layout": {
    "slots": [
      {
        "id": "todos",
        "runtime": "example.todo.frontend",
        "pod": "todos"
      }
    ]
  }
}
