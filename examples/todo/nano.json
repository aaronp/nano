{
  "pods": {
    "store": {
      "implementation": "example.kv/memory",
      "eager": false
    },
    "todos": {
      "implementation": "example.todo/kv",
      "eager": false
    }
  },
  "runtimes": {
    "frontend": {
      "pods": [
        "todos"
      ],
      "subscriptions": []
    },
    "backend": {
      "pods": [
        "store",
        "todos"
      ],
      "subscriptions": [
        {
          "kind": "call",
          "from": "todos",
          "to": "store"
        }
      ]
    }
  },
  "modules": {
    "example.kv": "./kv/memory.js",
    "example.todo": "./todo/kv.js"
  }
}
