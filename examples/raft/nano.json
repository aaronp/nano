{
  "pods": {
    "cluster": { "implementation": "example.raft/cluster", "config": { "timing": { "electionMin": 3000, "electionMax": 6000, "heartbeat": 1000 } }, "eager": false },
    "raft-messaging": { "implementation": "example.raft/messaging", "config": { "minMs": 200, "maxMs": 600 }, "eager": true },
    "raft-clock": { "implementation": "nano.ui/sim-clock", "eager": true },
    "raft-random": { "implementation": "nano.ui/seeded-random", "config": { "seed": 1 }, "eager": true }
  },
  "runtimes": {
    "raft": {
      "pods": ["cluster", "raft-messaging", "raft-clock", "raft-random"],
      "subscriptions": [
        { "kind": "call", "from": "raft-messaging", "to": "raft-clock" },
        { "kind": "call", "from": "raft-messaging", "to": "raft-random" }
      ]
    }
  },
  "modules": { "example.raft": "./index.js" },
  "layout": {
    "slots": [{ "id": "cluster", "runtime": "raft", "pod": "cluster" }],
    "ring": { "show": ["example.raft/node", "example.raft/messaging"] }
  }
}
