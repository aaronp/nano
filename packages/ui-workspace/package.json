{
  "name": "@composable/ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Host site: the workspace shell starter, hosting @composable components at build time (in markup) and at runtime (in the dock).",
  "scripts": {
    "build": "bun build src/main.ts --outdir public --format esm --minify --sourcemap=linked --loader .css:text",
    "dev": "bun build src/main.ts --outdir public --format esm --sourcemap=linked --loader .css:text --watch",
    "serve": "bunx serve public"
  },
  "dependencies": {
    "golden-layout": "^2.6.0",
    "lit": "^3.3.3",
    "typebox": "^1.4.0",
    "@composable/core": "workspace:*",
    "@composable/runes": "workspace:*",
    "@composable/elements": "workspace:*",
    "@composable/bundle": "workspace:*",
    "@composable/platform": "workspace:*",
    "@composable/editor": "workspace:*",
    "@composable/puzzle-port": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4"
  }
}
