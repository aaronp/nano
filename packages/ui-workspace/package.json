{
  "name": "@composable/ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Host site: the workspace shell starter, hosting @composable components at build time (in markup) and at runtime (in the dock).",
  "scripts": {
    "build": "bun scripts/prebuild.ts && bun scripts/build.ts",
    "dev": "bun scripts/prebuild.ts && bun scripts/build.ts --watch",
    "serve": "bunx serve public --cors",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@pritzlaff/nano-core": "workspace:*",
    "@pritzlaff/nano-elements": "workspace:*",
    "@pritzlaff/nano-host": "workspace:*",
    "@pritzlaff/nano-outline": "workspace:*",
    "@pritzlaff/nano-ui": "workspace:*",
    "golden-layout": "2.6.0",
    "lit": "^3.3.3",
    "typebox": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4"
  }
}
