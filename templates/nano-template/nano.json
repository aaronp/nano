{
  "pods": {
    "calculator": { "implementation": "acme.template/calculator", "eager": false },
    "history": { "implementation": "acme.template/history", "eager": false }
  },
  "runtimes": {
    "main": {
      "pods": ["calculator", "history"],
      "subscriptions": [
        { "kind": "pipe", "from": "calculator", "source": "acme.template.Calculator/calculated", "to": "history", "target": "acme.template.History/save" }
      ]
    }
  },
  "modules": { "acme.template": "./index.js" }
}
